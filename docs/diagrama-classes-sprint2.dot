digraph G {
graph [rankdir=TB, fontname="Helvetica", nodesep=0.45, ranksep=0.7, splines=true, pad=0.4,
       label=<<B>Diagrama de Classes — Sistema Hospitalar Vida (Sprint 2)</B><BR/><FONT POINT-SIZE="11">Azul: classe da Sprint 1 (com ajustes) · Laranja: nova na Sprint 2 · Roxo: enumeração · Itálico: classe/método abstrato</FONT>>,
       labelloc=t, fontsize=20];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
{rank=min; Pessoa; Atend;}
edge [fontname="Helvetica", fontsize=9, color="#444444"];
Pessoa [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e8c"><TR><TD BGCOLOR="#1f4e8c" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><B><I>Pessoa</I></B></FONT></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT"># id: Long<BR ALIGN="LEFT"/># nome: String<BR ALIGN="LEFT"/># telefone: String<BR ALIGN="LEFT"/># email: String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">+ atualizarContato(telefone: String, email: String): void<BR ALIGN="LEFT"/>+ validarEmail(): boolean<BR ALIGN="LEFT"/>+ atualizarNome(nome: String): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Paciente [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e8c"><TR><TD BGCOLOR="#1f4e8c" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>Paciente</B></FONT></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">- cpf: String<BR ALIGN="LEFT"/>- dataNascimento: LocalDate<BR ALIGN="LEFT"/>- endereco: String<BR ALIGN="LEFT"/>- historicoMedico: HistoricoMedico<BR ALIGN="LEFT"/>- atendimentos: List&lt;Atendimento&gt;<BR ALIGN="LEFT"/>- internacoes: List&lt;Internacao&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">+ calcularIdade(): int<BR ALIGN="LEFT"/>+ adicionarAtendimento(a: Atendimento): void<BR ALIGN="LEFT"/>+ adicionarInternacao(i: Internacao): void<BR ALIGN="LEFT"/>+ possuiInternacaoAtiva(): boolean<BR ALIGN="LEFT"/>+ possuiAtendimentoNoHorario(inicio, fim): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Historico [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e8c"><TR><TD BGCOLOR="#1f4e8c" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>HistoricoMedico</B></FONT></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">- id: Long<BR ALIGN="LEFT"/>- paciente: Paciente<BR ALIGN="LEFT"/>- informacoesRelevantes: String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">+ listarAtendimentos(): List&lt;Atendimento&gt;<BR ALIGN="LEFT"/>+ listarInternacoes(): List&lt;Internacao&gt;<BR ALIGN="LEFT"/>+ atualizarInformacoes(texto: String): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Prof [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e8c"><TR><TD BGCOLOR="#1f4e8c" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«abstract entity»</FONT><BR/><B><I>ProfissionalSaude</I></B></FONT></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">- registroProfissional: String<BR ALIGN="LEFT"/>- atendimentos: List&lt;Atendimento&gt;<BR ALIGN="LEFT"/>- internacoes: List&lt;Internacao&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">+ getCategoria(): CategoriaProfissional  {abstract}<BR ALIGN="LEFT"/>+ realizaConsultaRotina(): boolean<BR ALIGN="LEFT"/>+ atendeEspecialidade(e: Especialidade): boolean<BR ALIGN="LEFT"/>+ podeRealizarCirurgias(): boolean<BR ALIGN="LEFT"/>+ estaDisponivel(inicio, fim: LocalDateTime): boolean<BR ALIGN="LEFT"/>+ registrarObservacao(a: Atendimento, texto: String): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Clinico [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c0571b"><TR><TD BGCOLOR="#c0571b" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>ClinicoGeral</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf1e8"> </TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">+ realizaConsultaRotina(): boolean  «override»<BR ALIGN="LEFT"/>+ encaminhar(paciente, especialista, especialidade,<BR ALIGN="LEFT"/>      dataHora, motivo): ConsultaEspecializada<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Especialista [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c0571b"><TR><TD BGCOLOR="#c0571b" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>MedicoEspecialista</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">- especialidade: Especialidade<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">+ atendeEspecialidade(e): boolean  «override»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Cirurgiao [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c0571b"><TR><TD BGCOLOR="#c0571b" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>Cirurgiao</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">- areaCirurgica: String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">+ podeRealizarCirurgias(): boolean  «override»<BR ALIGN="LEFT"/>+ registrarProcedimento(...): ProcedimentoCirurgico<BR ALIGN="LEFT"/>+ listarProcedimentos(): List&lt;ProcedimentoCirurgico&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Atend [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c0571b"><TR><TD BGCOLOR="#c0571b" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«abstract entity»</FONT><BR/><B><I>Atendimento</I></B></FONT></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">- id: Long<BR ALIGN="LEFT"/>- paciente: Paciente<BR ALIGN="LEFT"/># profissional: ProfissionalSaude<BR ALIGN="LEFT"/>- dataHora: LocalDateTime<BR ALIGN="LEFT"/>- observacoes: String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">+ validar(): void   (template method)<BR ALIGN="LEFT"/># validarCondicoes(): void  {abstract}<BR ALIGN="LEFT"/>+ getTipo(): String  {abstract}<BR ALIGN="LEFT"/>+ getDuracaoEstimadaMinutos(): int  {abstract}<BR ALIGN="LEFT"/>+ ocupaAgenda(): boolean  {abstract}<BR ALIGN="LEFT"/>+ conflitaCom(inicio, fim: LocalDateTime): boolean<BR ALIGN="LEFT"/>+ registrarObservacoes(texto: String): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Consulta [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e8c"><TR><TD BGCOLOR="#1f4e8c" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«abstract entity»</FONT><BR/><B><I>Consulta</I></B></FONT></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">- motivo: String<BR ALIGN="LEFT"/>- situacao: SituacaoConsulta<BR ALIGN="LEFT"/>- consultaOriginal: Consulta<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT"># validarRegrasDaModalidade(): void  {abstract}<BR ALIGN="LEFT"/>+ validarHorario(): boolean<BR ALIGN="LEFT"/>+ alterarSituacao(nova: SituacaoConsulta): void<BR ALIGN="LEFT"/>+ confirmar() / iniciarAtendimento(): void<BR ALIGN="LEFT"/>+ concluir(observacoes: String): void<BR ALIGN="LEFT"/>+ cancelar() / registrarFalta(): void<BR ALIGN="LEFT"/>+ reagendar(novaDataHora): Consulta<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Rotina [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c0571b"><TR><TD BGCOLOR="#c0571b" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>ConsultaRotina</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf1e8"> </TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT"># validarRegrasDaModalidade(): exige clínico geral<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Especializada [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c0571b"><TR><TD BGCOLOR="#c0571b" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>ConsultaEspecializada</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">- especialidade: Especialidade<BR ALIGN="LEFT"/>- encaminhadoPor: ClinicoGeral<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT"># validarRegrasDaModalidade(): exige médico<BR ALIGN="LEFT"/>      da mesma especialidade<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Emerg [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c0571b"><TR><TD BGCOLOR="#c0571b" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>AtendimentoEmergencia</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">- prioridade: Prioridade<BR ALIGN="LEFT"/>- status: StatusEmergencia<BR ALIGN="LEFT"/>- queixaPrincipal: String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT"># validarCondicoes(): exige prioridade e queixa<BR ALIGN="LEFT"/>+ iniciarAvaliacao(medico: ProfissionalSaude): void<BR ALIGN="LEFT"/>+ concluir(observacoes: String): void<BR ALIGN="LEFT"/>+ aguardandoAvaliacao(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Proc [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c0571b"><TR><TD BGCOLOR="#c0571b" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>ProcedimentoCirurgico</B></FONT></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">- descricao: String<BR ALIGN="LEFT"/>- tipoCirurgia: TipoCirurgia<BR ALIGN="LEFT"/>- observacoesPreOperatorias: String<BR ALIGN="LEFT"/>- observacoesPosOperatorias: String<BR ALIGN="LEFT"/>- duracaoPrevistaMinutos: int<BR ALIGN="LEFT"/>- dataHoraInicioEfetivo: LocalDateTime<BR ALIGN="LEFT"/>- dataHoraFimEfetivo: LocalDateTime<BR ALIGN="LEFT"/>- status: StatusProcedimento<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT"># validarCondicoes(): exige cirurgião<BR ALIGN="LEFT"/>+ iniciar(): void<BR ALIGN="LEFT"/>+ concluir(obsPos: String): void  (só se iniciado)<BR ALIGN="LEFT"/>+ cancelar(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Internacao [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e8c"><TR><TD BGCOLOR="#1f4e8c" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>Internacao</B></FONT></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">- id: Long<BR ALIGN="LEFT"/>- dataEntrada: LocalDateTime<BR ALIGN="LEFT"/>- dataPrevistaAlta: LocalDate<BR ALIGN="LEFT"/>- dataEfetivaAlta: LocalDate<BR ALIGN="LEFT"/>- observacoes: String<BR ALIGN="LEFT"/>- status: StatusInternacao<BR ALIGN="LEFT"/>- paciente: Paciente<BR ALIGN="LEFT"/>- profissional: ProfissionalSaude<BR ALIGN="LEFT"/>- quarto: Quarto<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">+ iniciar(): void<BR ALIGN="LEFT"/>+ registrarAlta(data: LocalDate): void<BR ALIGN="LEFT"/>+ transferir(quarto: Quarto): void<BR ALIGN="LEFT"/>+ cancelar(): void<BR ALIGN="LEFT"/>+ estaAtiva(): boolean<BR ALIGN="LEFT"/>+ calcularDiasInternado(): long<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Quarto [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e8c"><TR><TD BGCOLOR="#1f4e8c" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>Quarto</B></FONT></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">- id: Long<BR ALIGN="LEFT"/>- numero: String<BR ALIGN="LEFT"/>- andar: int<BR ALIGN="LEFT"/>- capacidadeMaxima: int<BR ALIGN="LEFT"/>- ocupacaoAtual: int<BR ALIGN="LEFT"/>- situacao: SituacaoQuarto<BR ALIGN="LEFT"/>- tipo: TipoQuarto<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#eef3fb" ALIGN="LEFT" BALIGN="LEFT">+ possuiVaga(): boolean<BR ALIGN="LEFT"/>+ ocupar(): void<BR ALIGN="LEFT"/>+ liberar(): void<BR ALIGN="LEFT"/>+ atualizarSituacao(): void<BR ALIGN="LEFT"/>+ marcarIndisponivel() / liberarParaUso(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ESit [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b3d8f"><TR><TD BGCOLOR="#5b3d8f" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«enum»</FONT><BR/><B>SituacaoConsulta</B></FONT></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">AGENDADA<BR ALIGN="LEFT"/>CONFIRMADA<BR ALIGN="LEFT"/>EM_ATENDIMENTO<BR ALIGN="LEFT"/>CONCLUIDA<BR ALIGN="LEFT"/>CANCELADA<BR ALIGN="LEFT"/>NAO_COMPARECEU<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">+ podeMudarPara(nova): boolean<BR ALIGN="LEFT"/>+ isFinal(): boolean<BR ALIGN="LEFT"/>+ ocupaAgenda(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
EProc [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b3d8f"><TR><TD BGCOLOR="#5b3d8f" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«enum»</FONT><BR/><B>StatusProcedimento</B></FONT></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">AGENDADO<BR ALIGN="LEFT"/>EM_ANDAMENTO<BR ALIGN="LEFT"/>CONCLUIDO<BR ALIGN="LEFT"/>CANCELADO<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">+ podeMudarPara(novo): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
EEmerg [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b3d8f"><TR><TD BGCOLOR="#5b3d8f" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«enum»</FONT><BR/><B>StatusEmergencia</B></FONT></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">AGUARDANDO_AVALIACAO<BR ALIGN="LEFT"/>EM_ATENDIMENTO<BR ALIGN="LEFT"/>CONCLUIDO<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">+ podeMudarPara(novo): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
EPrio [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b3d8f"><TR><TD BGCOLOR="#5b3d8f" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«enum»</FONT><BR/><B>Prioridade</B></FONT></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">BAIXA(1)<BR ALIGN="LEFT"/>MODERADA(2)<BR ALIGN="LEFT"/>ALTA(3)<BR ALIGN="LEFT"/>CRITICA(4)<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">+ getNivel(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
EEsp [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b3d8f"><TR><TD BGCOLOR="#5b3d8f" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«enum»</FONT><BR/><B>Especialidade</B></FONT></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">CARDIOLOGIA, NEUROLOGIA,<BR ALIGN="LEFT"/>ORTOPEDIA, PEDIATRIA,<BR ALIGN="LEFT"/>DERMATOLOGIA, GINECOLOGIA,<BR ALIGN="LEFT"/>ONCOLOGIA, PSIQUIATRIA<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ETipoCir [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b3d8f"><TR><TD BGCOLOR="#5b3d8f" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«enum»</FONT><BR/><B>TipoCirurgia</B></FONT></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">ELETIVA<BR ALIGN="LEFT"/>URGENCIA<BR ALIGN="LEFT"/>EMERGENCIA<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ECat [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b3d8f"><TR><TD BGCOLOR="#5b3d8f" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«enum»</FONT><BR/><B>CategoriaProfissional</B></FONT></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">CLINICO_GERAL<BR ALIGN="LEFT"/>ESPECIALISTA<BR ALIGN="LEFT"/>CIRURGIAO<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
EInt [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b3d8f"><TR><TD BGCOLOR="#5b3d8f" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«enum»</FONT><BR/><B>StatusInternacao</B></FONT></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">ATIVA<BR ALIGN="LEFT"/>ENCERRADA<BR ALIGN="LEFT"/>CANCELADA<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ESitQ [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b3d8f"><TR><TD BGCOLOR="#5b3d8f" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«enum»</FONT><BR/><B>SituacaoQuarto</B></FONT></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">DISPONIVEL<BR ALIGN="LEFT"/>PARCIALMENTE_OCUPADO<BR ALIGN="LEFT"/>LOTADO<BR ALIGN="LEFT"/>INDISPONIVEL<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ETipoQ [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b3d8f"><TR><TD BGCOLOR="#5b3d8f" ALIGN="CENTER"><FONT COLOR="white"><FONT POINT-SIZE="9">«enum»</FONT><BR/><B>TipoQuarto</B></FONT></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">ENFERMARIA (máx. 6 leitos)<BR ALIGN="LEFT"/>APARTAMENTO (máx. 2)<BR ALIGN="LEFT"/>UTI (máx. 10, exige justificativa)<BR ALIGN="LEFT"/>ISOLAMENTO (máx. 1, exige justificativa)<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#f3eefa" ALIGN="LEFT" BALIGN="LEFT">+ getLimiteLeitos(): int<BR ALIGN="LEFT"/>+ exigeJustificativa(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
